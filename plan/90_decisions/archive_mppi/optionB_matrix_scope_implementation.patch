@@ -0,0 +1,98 @@
+"""Anti-abuse tests for policy-declared exclusions in the frozen matrix.
+
+An exclusion may only remove slots of a backend that never passed native runtime
+admission, it must cover exactly those slots, and it must never hide a missing
+executed slot, an illegal reason, a substituted model or a slot that already has
+terminal evidence."""
+from pathlib import Path
+import json
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'src'))
+from yopo_eval.aggregate import aggregate,BACKEND_BY_MODEL,collect_exclusions
+from yopo_eval.task_spec import resolve_episode
+
+MODELS = ('yopo_seed0','mppi_reference17')
+MPPI_IDS = ('mppi_reference17_t00','mppi_reference17_t01')
+YOPO_IDS = ('yopo_seed0_t00','yopo_seed0_t01')
+
+
+def protocol():
+    episodes = [{'id':'%s_t%02d'%(model,index),'model':model,'task_index':0,'speed_mps':2,'paper_first10':True}
+                for model in MODELS for index in range(2)]
+    return {'tasks':[{'condition':'sparse'}],'episodes':episodes}
+
+
+def skip(episode_id,model='mppi_reference17',status='not_attempted_backend_unavailable'):
+    return {'episode_id':episode_id,'model':model,'status':status}
+
+
+def ledger(entries):
+    return {'episodes':{entry['episode_id']:entry for entry in entries}}
+
+
+def records_for(ids,status='success'):
+    return {episode_id:{'status':status,'metrics':{}} for episode_id in ids}
+
+
+def test_legal_exclusions_reach_admitted_scope_complete():
+    excluded,problems = collect_exclusions(protocol(),ledger([skip(i) for i in MPPI_IDS]),['yopo'])
+    assert problems==[]
+    report = aggregate(protocol(),records_for(YOPO_IDS),excluded=excluded)
+    assert report['status']=='outcome_coverage_complete_for_admitted_scope'
+    assert report['admitted_expected_episodes']==2 and report['completed_episodes']==2
+    assert len(report['excluded_episodes'])==2 and report['exclusion_problems']==[]
+    yopo = next(row for row in report['groups'] if row['model']=='yopo_seed0')
+    assert (yopo['expected'],yopo['admitted_expected'],yopo['excluded'],yopo['completed'])==(2,2,0,2)
+    assert yopo['possible_final_success_rate_bounds']==[1.0,1.0]
+    mppi = next(row for row in report['groups'] if row['model']=='mppi_reference17')
+    assert (mppi['expected'],mppi['admitted_expected'],mppi['excluded'],mppi['completed'])==(2,0,2,0)
+    assert mppi['success_rate_among_completed'] is None
+    assert mppi['possible_final_success_rate_bounds']==[0.0,1.0]  # excluded slots stay unknown
+
+
+def test_exclusion_list_must_match_the_policy_slot_set_exactly():
+    for ids in (MPPI_IDS[:1],MPPI_IDS+YOPO_IDS):
+        excluded,problems = collect_exclusions(protocol(),ledger([skip(i) for i in ids]),['yopo'])
+        report = aggregate(protocol(),records_for(YOPO_IDS),excluded=excluded,exclusion_problems=problems)
+        assert problems and report['status']=='incomplete'
+
+
+def test_validated_backend_slot_cannot_be_excluded():
+    entries = [skip(i) for i in MPPI_IDS]+[skip('yopo_seed0_t00','yopo_seed0')]
+    excluded,problems = collect_exclusions(protocol(),ledger(entries),['yopo'])
+    assert any('illegal' in entry.get('problem','') for entry in problems)
+    report = aggregate(protocol(),records_for(['yopo_seed0_t01']),excluded=excluded,exclusion_problems=problems)
+    assert report['status']=='incomplete'
+
+
+def test_unknown_exclusion_reason_is_rejected():
+    entries = [skip(i,status='not_attempted_attempts_exhausted') for i in MPPI_IDS]
+    excluded,problems = collect_exclusions(protocol(),ledger(entries),['yopo'])
+    assert any('reason not allowed' in entry.get('problem','') for entry in problems)
+    report = aggregate(protocol(),records_for(YOPO_IDS),excluded=excluded,exclusion_problems=problems)
+    assert report['status']=='incomplete'
+
+
+def test_excluded_slot_with_terminal_evidence_is_a_problem():
+    excluded,problems = collect_exclusions(protocol(),ledger([skip(i) for i in MPPI_IDS]),['yopo'])
+    report = aggregate(protocol(),records_for(YOPO_IDS+MPPI_IDS),excluded=excluded,exclusion_problems=problems)
+    assert any('terminal evidence' in entry.get('problem','') for entry in report['exclusion_problems'])
+    assert report['status']=='incomplete'
+
+
+def test_no_validated_backend_means_no_exclusions_are_legal():
+    excluded,problems = collect_exclusions(protocol(),ledger([skip(i) for i in MPPI_IDS]),[])
+    assert excluded=={} and problems
+
+
+def test_backend_mapping_agrees_with_the_frozen_resolver():
+    protocol_path = ROOT/'benchmarks/protocol_v1/protocol.json'
+    data = json.loads(protocol_path.read_text(encoding='utf-8'))
+    seen = {}
+    for episode in data['episodes']:
+        seen.setdefault(episode['model'],episode['id'])
+    assert set(seen)==set(BACKEND_BY_MODEL)
+    for model,episode_id in seen.items():
+        assert resolve_episode(protocol_path,episode_id)['backend']==BACKEND_BY_MODEL[model]
