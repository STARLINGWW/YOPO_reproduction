# Numerical reference only. OS remains Jammy; ROS2 Python3.10 is untouched.
FROM yopo-repro:ros-humble-jammy
USER root
ENV DEBIAN_FRONTEND=noninteractive TF_CPP_MIN_LOG_LEVEL=2 \
    OMP_NUM_THREADS=4 TF_NUM_INTRAOP_THREADS=4 TF_NUM_INTEROP_THREADS=1
RUN --mount=type=cache,id=yopo-jammy-apt,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=yopo-jammy-lists,target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
       libssl-dev zlib1g-dev libbz2-dev libffi-dev libsqlite3-dev libreadline-dev liblzma-dev xz-utils
RUN mkdir -p /tmp/yopo-python-build \
    && cd /tmp/yopo-python-build \
    && curl --fail --location --retry 5 https://www.python.org/ftp/python/3.8.20/Python-3.8.20.tar.xz -o source.tar.xz \
    && printf '%s\n' '745478c81d6382cf46b5e7ad89e56008  source.tar.xz' | md5sum -c - \
    && sha256sum source.tar.xz > /opt/yopo-python38-source.sha256 \
    && tar -xf source.tar.xz \
    && cd Python-3.8.20 \
    && ./configure --prefix=/opt/yopo-python38 --with-ensurepip=install \
    && make -j4 \
    && make altinstall \
    && /opt/yopo-python38/bin/python3.8 -c 'import ssl,sqlite3,lzma; print(ssl.OPENSSL_VERSION)'
RUN --mount=type=cache,id=yopo-agile-reference-pip,target=/root/.cache/pip \
    /opt/yopo-python38/bin/python3.8 -m pip install --timeout 120 --retries 10 pip==24.3.1 \
    && /opt/yopo-python38/bin/python3.8 -m pip install --timeout 120 --retries 10 \
       tensorflow-cpu==2.4.0 numpy==1.19.5 protobuf==3.20.3 \
    && /opt/yopo-python38/bin/python3.8 -m pip check
USER yopo
