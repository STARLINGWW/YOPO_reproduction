FROM yopo-repro:ros-humble-jammy
USER root
ENV TF_CPP_MIN_LOG_LEVEL=2 TF_ENABLE_ONEDNN_OPTS=0 \
    OMP_NUM_THREADS=4 TF_NUM_INTRAOP_THREADS=4 TF_NUM_INTEROP_THREADS=1
RUN --mount=type=cache,id=yopo-agile-pip,target=/root/.cache/pip \
    python3 -m pip install --timeout 120 --retries 10 pip==25.2 \
    && python3 -m pip install --timeout 120 --retries 10 --resume-retries 10 \
       tensorflow-cpu==2.15.1 numpy==1.26.4 scipy==1.13.1 opencv-python-headless==4.11.0.86 pyyaml==6.0.2 \
    && python3 -m pip check
USER yopo
