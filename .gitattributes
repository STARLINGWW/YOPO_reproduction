* text=auto eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.json text eol=lf

# Large reproducibility objects: use Git LFS only when the repository quota is
# ready. Small curated demo media under report/05_visualization/media is
# intentionally committed (few MB) and goes through LFS as well.
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.data-* filter=lfs diff=lfs merge=lfs -text
*.ply filter=lfs diff=lfs merge=lfs -text
*.f32 filter=lfs diff=lfs merge=lfs -text
*.u8 filter=lfs diff=lfs merge=lfs -text

# Byte-anchored evidence files: recorded sha256 values (protocol missions,
# runtime admission, dataset manifests) are computed over the raw bytes, so
# Git must store these files byte-for-byte and never apply end-of-line
# normalisation. Verified 2026-10-13: without this, a fresh clone changes the
# bytes of protocol.json/maps and every recorded hash check fails.
benchmarks/protocol_v1/protocol.json -text
benchmarks/protocol_v1/maps/*.json -text
benchmarks/protocol_v1/runtime_validation.json -text
configs/unified_quad.json -text
configs/topotraj/isaac_development.yaml -text
datasets/** -text
artifacts/** -text
checkpoints/** -text
external/audit_sources/** -text

# Reference-arm files keep their exact bytes: clean-clone hashes must match the
# protocol's recorded sha256 (maps, protocol) and the admission's protocol hash.
benchmarks/reference_arm_official_v1/protocol.json -text
benchmarks/reference_arm_official_v1/maps/*.json -text
benchmarks/reference_arm_official_v1/runtime_validation.json -text
